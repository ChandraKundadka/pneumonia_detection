{
  "name": "Pneumonia ML Workspace",

  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "frontend",
  "workspaceFolder": "/app",

  "forwardPorts": [8501, 7860],

  "portsAttributes": {
    "8501": {
      "label": "Streamlit UI",
      "onAutoForward": "openBrowser"
    },
    "7860": {
      "label": "Pneumonia Detection API",
      "onAutoForward": "silent"
    }
  },

  "remoteEnv": {
    "HF_TOKEN": "${localEnv:HF_TOKEN}"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
